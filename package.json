{
  "name": "usx",
  "version": "3.0.1",
  "description": "Reactive vanilla jsx",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "c8 --all --include=src/**/*.ts --reporter=html --reporter=text mocha --import=tsx test/**/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrew24601/usx.git"
  },
  "author": "Andrew Barry",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/andrew24601/usx/issues"
  },
  "homepage": "https://github.com/andrew24601/usx#readme",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "jsdom": "^29.1.1",
    "jsdom-global": "^3.0.2",
    "mocha": "^11.7.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ],
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.6"
  }
}
