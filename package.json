{
  "name": "usx",
  "version": "4.0.0",
  "description": "A small direct-DOM JSX runtime with explicit synchronization",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.19.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "c8 --all --include=src/**/*.ts --reporter=html --reporter=text node --import=tsx --test test/test.ts",
    "typecheck": "npm run build && tsc -p tsconfig.typecheck.json && tsc -p tsconfig.typecheck.json --jsx react-jsxdev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrew24601/usx.git"
  },
  "author": "Andrew Barry",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/andrew24601/usx/issues"
  },
  "homepage": "https://github.com/andrew24601/usx#readme",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "c8": "^12.0.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ]
}
